{
  "name": "headlamp-theme-builder",
  "version": "1.0.0",
  "description": "Build, preview, and export Headlamp themes from inside Headlamp.",
  "author": {
    "name": "Pixelrobots",
    "url": "https://pixelrobots.co.uk"
  },
  "homepage": "https://pixelrobots.github.io/headlamp-theme-builder/",
  "repository": {
    "type": "git",
    "url": "https://github.com/PixelRobots/headlamp-theme-builder.git",
    "directory": "headlamp-plugin"
  },
  "scripts": {
    "prestart": "node scripts/ensure-headlamp-plugin-dir.cjs",
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "eslint --cache -c package.json --max-warnings 0 --ext .js,.ts,.tsx src/",
    "lint-fix": "eslint --cache -c package.json --max-warnings 0 --ext .js,.ts,.tsx src/ --fix",
    "package": "headlamp-plugin package",
    "tsc": "tsc --noEmit",
    "storybook": "headlamp-plugin storybook",
    "test": "vitest -c node_modules/@kinvolk/headlamp-plugin/config/vite.config.mjs",
    "storybook-build": "headlamp-plugin storybook-build"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "theme",
    "branding"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "react-colorful": "^5.6.1"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  },
  "overrides": {
    "typescript": "5.6.2"
  }
}
